// Cloudflare Workers static assets: serve the built site in ./dist.
// The build runs first in Workers Builds (npm run build); `wrangler deploy` then only uploads dist.
{
  "name": "victoireappstudio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // /kit serves dist/kit/index.html, and /kit/ redirects to /kit (matches the site's canonical URLs)
    "html_handling": "drop-trailing-slash",
    // unknown paths get dist/404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
