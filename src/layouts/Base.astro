---
import '../styles/base.css';
import Motion from '../components/Motion.astro';

interface Props {
  title: string;
  description: string;
  /** Path of the 1200x630 share image under public/. */
  ogImage?: string;
  /** App Store id for the Smart App Banner, live app pages only. */
  appStoreId?: string | null;
  /** A schema.org JSON-LD string (src/lib/jsonld.ts). */
  jsonLd?: string | null;
}

const { title, description, ogImage = '/og/home.png', appStoreId, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = ogImage ? new URL(ogImage, Astro.site) : null;
---

<!doctype html>
<html lang="en" data-type="software">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F6F5F6" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Victoir App Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    {appStoreId && <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <!-- entrances wait for the script; if it never runs, .safe shows everything after 2.5s -->
    <script is:inline>document.documentElement.classList.add('js');setTimeout(()=>document.documentElement.classList.add('safe'),2500)</script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <Motion />
  </body>
</html>
