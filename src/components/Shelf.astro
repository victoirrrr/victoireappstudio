---
// PRD 7.3 / DESIGN.md Shelf: one rounded panel, All apps / Kit family tabs, a coverflow row of
// app cards where the focused card grows and its object breaks out of the top, and a detail strip
// with the page's one App Store badge. Renders from src/data/apps: a new app joins with no code change.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Picture } from 'astro:assets';
import { getApps, storeLink } from '../lib/apps';

const apps = await getApps();
const first = apps[0];

// The heading names the apps from the data: stand-alone apps by name, then each family once.
const named: string[] = [];
for (const a of apps) {
  if (!a.family) named.push(a.name);
  else if (!named.includes(`the ${a.family[0].toUpperCase()}${a.family.slice(1)} family`))
    named.push(`the ${a.family[0].toUpperCase()}${a.family.slice(1)} family`);
}
const heading = named.length > 1 ? `${named.slice(0, -1).join(', ')} and ${named.at(-1)}` : named[0];

// The official badge (Apple Marketing Tools, black, unmodified) goes in public/badges/.
// Until it is there, the strip shows a plain pill with the badge's own words.
const BADGE = '/badges/app-store-black.svg';
// resolved from the project root: import.meta.url points at the compiled chunk during a build
const hasBadge = existsSync(join(process.cwd(), 'public', BADGE));

const view = apps.map((app) => ({
  app,
  field: app.shelf?.field ?? app.palette.bg,
  ink: app.shelf?.ink ?? app.palette.ink,
  lockup: app.shelf?.lockup ?? 'sans',
  pill: app.isLive && app.price ? app.price : app.statusLabel,
  meta: app.isLive ? app.category : app.family === 'kit' ? 'Kit family' : 'iOS app',
  facts: app.isLive ? app.facts : app.status === 'planned' ? 'Planned for 2027' : 'Coming soon',
  store: storeLink(app, 'shelf'),
}));
---

<section class="section shelf" id="apps" aria-labelledby="apps-h" style="--h: 1">
  <div class="wrap">
    <h2 id="apps-h">{heading}</h2>

    <div class="panel" data-shelf>
      <div class="panel__head" role="tablist" aria-label="Show apps">
        <button class="tab" role="tab" type="button" aria-selected="true" data-filter="all">All apps</button>
        <button class="tab" role="tab" type="button" aria-selected="false" data-filter="kit" tabindex="-1">Kit family</button>
      </div>

      <div class="stage" data-stage>
        <div class="track" role="radiogroup" aria-label="Choose an app" data-track>
          {view.map((v, i) => (
            <button
              class="sc"
              id={v.app.slug}
              type="button"
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-index={i}
              data-family={v.app.family ?? ''}
              data-lockup={v.lockup}
              style={`--field:${v.field};--ink:${v.ink};--accent:${v.app.palette.accent}`}
            >
              {v.app.breakoutImage && (
                <span class="sc__obj" aria-hidden="true">
                  <Picture src={v.app.breakoutImage} formats={['avif']} fallbackFormat="webp" widths={[240, 480]} sizes="240px" loading="lazy" alt="" />
                </span>
              )}
              <span class="sc__field">
                <span class="sc__name">{v.app.name}</span>
                <span class="sc__foot">
                  <span class="sc__meta">{v.meta}</span>
                  <span class="sc__pill">{v.pill}</span>
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="detail" data-detail aria-live="polite">
        {view.map((v) => (
          <div class="detail__item" data-for={v.app.slug} hidden={v.app.slug !== first.slug}>
            {v.app.iconImage ? (
              <Picture class="detail__icon" src={v.app.iconImage} formats={['avif']} fallbackFormat="webp" width={56} height={56} densities={[1, 2]} alt="" />
            ) : (
              <span class="detail__icon detail__icon--blank" style={`--c:${v.field}`} aria-hidden="true" />
            )}
            <div class="detail__id">
              <p class="detail__name">{v.app.name}</p>
              <p class="detail__facts">{v.facts}</p>
            </div>
            <p class="detail__line">{v.app.oneLiner}</p>
            <div class="detail__cta">
              {v.store ? (
                hasBadge ? (
                  <a class="badge" href={v.store} rel="noopener">
                    <img src={BADGE} width="120" height="40" alt={`Download ${v.app.name} on the App Store`} />
                  </a>
                ) : (
                  <a class="btn btn--primary" href={v.store} rel="noopener">Download on the App Store</a>
                )
              ) : (
                <p class="detail__soon">{v.app.status === 'planned' ? 'Coming 2027' : 'Coming soon'}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- The focused card's organic outline (ref 3): the top edge rises toward the right. Bounding-box
       units, so it scales with the card. -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <clipPath id="sc-organic" clipPathUnits="objectBoundingBox">
      <path d="M0,.215 C0,.15 .045,.108 .13,.1 L.845,.006 C.935,-.004 1,.05 1,.13 L1,.87 C1,.94 .94,1 .853,1 L.147,1 C.06,1 0,.94 0,.87 Z" />
    </clipPath>
  </svg>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-shelf]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const cards = [...root.querySelectorAll<HTMLButtonElement>('.sc')];
    const items = [...root.querySelectorAll<HTMLElement>('.detail__item')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let current = cards[0];

    const visible = () => cards.filter((c) => !c.hidden);

    const place = () => {
      // A row that fits is centred. A longer row starts flush left and slides only as far as it
      // must to bring the focused card to the middle, never past either end. Transform only.
      const sw = stage.clientWidth;
      const tw = track.scrollWidth;
      let x: number;
      if (tw <= sw) {
        // centre what is drawn: a card at rest is scaled down inside its slot
        const v = visible();
        const rest = parseFloat(getComputedStyle(stage).getPropertyValue('--sc-rest')) || 1;
        const inset = (c: HTMLElement) => (c === current ? 0 : (c.offsetWidth * (1 - rest)) / 2);
        const a = v[0], b = v[v.length - 1];
        const left = a.offsetLeft + inset(a);
        const right = b.offsetLeft + b.offsetWidth - inset(b);
        x = sw / 2 - (left + right) / 2;
      }
      else x = Math.min(0, Math.max(sw - tw, sw / 2 - (current.offsetLeft + current.offsetWidth / 2)));
      track.style.setProperty('--shift', `${x}px`);
      stage.dataset.more = [x < -1 ? 'start' : '', x > sw - tw + 1 && tw > sw ? 'end' : ''].join(' ').trim();
    };

    const select = (card: HTMLButtonElement, focus = false) => {
      if (card.hidden) return;
      current = card;
      for (const c of cards) {
        const on = c === card;
        c.setAttribute('aria-checked', String(on));
        c.tabIndex = on ? 0 : -1;
      }
      for (const it of items) {
        const on = it.dataset.for === card.id;
        if (on && it.hidden) {
          it.hidden = false;
          it.classList.remove('is-in');
          void it.offsetWidth;
          it.classList.add('is-in');
        } else if (!on) it.hidden = true;
      }
      place();
      if (focus) card.focus({ preventScroll: true });
    };

    const step = (d: number) => {
      const v = visible();
      const i = v.indexOf(current);
      const next = v[Math.max(0, Math.min(v.length - 1, i + d))];
      if (next && next !== current) select(next, true);
    };

    cards.forEach((c) => c.addEventListener('click', () => select(c)));
    track.addEventListener('keydown', (e) => {
      const keys: Record<string, () => void> = {
        ArrowRight: () => step(1),
        ArrowDown: () => step(1),
        ArrowLeft: () => step(-1),
        ArrowUp: () => step(-1),
        Home: () => select(visible()[0], true),
        End: () => select(visible().at(-1)!, true),
      };
      const fn = keys[e.key];
      if (fn) { e.preventDefault(); fn(); }
    });

    // swipe on touch: a horizontal drag of 40px moves one card
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') x0 = e.clientX; });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
    });

    // tabs: All apps / Kit family
    const filter = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      }
      const fam = tab.dataset.filter;
      for (const c of cards) c.hidden = fam !== 'all' && c.dataset.family !== fam;
      if (focus) tab.focus();
      select(current.hidden ? visible()[0] : current);
    };
    tabs.forEach((t) => t.addEventListener('click', () => filter(t)));
    root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
      ev.preventDefault();
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      filter(tabs[(i + (ev.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
    });

    // deep links: /#kwesti, /#morb, /#kit focus that card and bring the shelf into view
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const card = cards.find((c) => c.id === id);
      if (!card) return;
      if (card.hidden) filter(tabs[0]);
      select(card);
      root.closest('section')?.scrollIntoView({ block: 'start' });
    };
    window.addEventListener('hashchange', fromHash);

    new ResizeObserver(place).observe(stage);
    root.classList.add('is-live');
    select(current);
    fromHash();
  }
</script>

<style>
  .shelf h2 {
    margin-bottom: var(--s-6);
  }

  /* ---------- panel */
  .panel {
    background: rgb(255 255 255 / 0.72);
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    box-shadow: var(--shadow-panel);
    --pad: var(--s-6);
    padding: var(--s-5) var(--pad);
    overflow: clip;
  }
  .panel__head {
    display: flex;
    gap: var(--s-6);
  }
  .tab {
    position: relative;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    transition: color var(--t-fast) var(--ease);
  }
  .tab:hover { color: var(--ink); }
  .tab[aria-selected='true'] { color: var(--ink); }
  .tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--crimson);
  }

  /* ---------- stage and track */
  .stage {
    --sc-w: 300px;
    --sc-h: 340px;
    --sc-rest: 0.767; /* 230 x 260 at rest, 300 x 340 focused (DESIGN.md: about 220 x 260) */
    --sc-gap: -16px;
    position: relative;
    padding-top: 56px; /* room for the break-out object */
    /* the row runs to the panel's edges; the panel's rounded edge cuts it (ref 3) */
    margin-inline: calc(-1 * var(--pad));
    touch-action: pan-y;
  }
  .track {
    padding-inline: var(--pad);
    display: flex;
    gap: var(--sc-gap);
    width: max-content;
    transform: translateX(var(--shift, 0px));
    transition: transform var(--t-mid) var(--ease);
  }
  /* without script: the row starts at the left edge and wraps nothing */
  .panel:not(.is-live) .track { transform: none; }

  /* ---------- a card */
  .sc {
    position: relative;
    flex: none;
    width: var(--sc-w);
    height: var(--sc-h);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transform: scale(var(--sc-rest));
    transition: transform var(--t-mid) var(--ease);
  }
  .sc[aria-checked='true'] {
    transform: none;
    z-index: 2;
    cursor: default;
  }
  .sc[hidden] { display: none; }
  .sc:focus-visible { outline: 2px solid var(--crimson); outline-offset: 4px; border-radius: var(--r-shelf); }

  .sc__field {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px 26px 24px;
    border-radius: var(--r-shelf);
    color: var(--ink);
    background:
      radial-gradient(120% 90% at 25% 0%, color-mix(in oklab, var(--accent) 26%, var(--field)), var(--field) 62%);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--field) 88%, #000);
  }
  .sc[aria-checked='true'] .sc__field {
    border-radius: 0;
    clip-path: url(#sc-organic);
    padding-top: 64px;
  }
  .sc__name {
    margin-top: auto;
    margin-bottom: auto;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .sc[data-lockup='display'] .sc__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.375rem; /* under 40px: display text of 40px+ reads as a heading */
    letter-spacing: var(--track-display);
  }
  .sc__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .sc__meta {
    font-size: var(--fs-small);
    opacity: 0.78;
  }
  .sc__pill {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    font-size: var(--fs-small);
    font-weight: 600;
    background: color-mix(in oklab, var(--ink) 14%, transparent);
    white-space: nowrap;
  }

  /* the break-out object: rises from the focused card's top edge (ref 3's astronaut) */
  .sc__obj {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: -50px;
    height: 150px;
    /* only the focused card's object is in the page: the others are not displayed, so their
       lazy images never load until that card is chosen */
    display: none;
    translate: -50% 0;
    opacity: 1;
    pointer-events: none;
    transition: opacity var(--t-fast) var(--ease), translate var(--t-mid) var(--ease);
    filter: drop-shadow(0 18px 24px rgb(14 16 32 / 0.28));
  }
  .sc__obj :global(picture) { display: block; height: 100%; }
  .sc__obj :global(img) { height: 100%; width: auto; max-width: none; }
  .sc[aria-checked='true'] .sc__obj { display: block; }
  @starting-style {
    .sc[aria-checked='true'] .sc__obj { opacity: 0; translate: -50% 12px; }
  }
  /* keep the name clear of the object */
  .sc:has(.sc__obj)[aria-checked='true'] .sc__name { margin-top: 110px; margin-bottom: 0; }

  /* ---------- detail strip */
  .detail {
    margin-top: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .detail__item {
    display: grid;
    grid-template-columns: 56px minmax(180px, 220px) 1fr auto;
    align-items: center;
    column-gap: var(--s-5);
  }
  .detail__item[hidden] { display: none; }
  .detail__item.is-in { animation: detail-in var(--t-fast) var(--ease); }
  @keyframes detail-in { from { opacity: 0; } }
  .detail :global(.detail__icon),
  .detail__icon--blank {
    width: 56px;
    height: 56px;
    border-radius: 13px;
  }
  .detail__icon--blank { display: block; background: var(--c); }
  .detail__name { font-size: var(--fs-h3); line-height: var(--lh-h3); font-weight: 600; }
  .detail__facts { font-size: var(--fs-small); color: var(--ink-2); }
  .detail__line { color: var(--ink); max-width: 52ch; }
  .detail__soon { font-weight: 600; color: var(--ink-2); }
  .badge img { height: 40px; width: auto; }

  @media (prefers-reduced-motion: reduce) {
    .track, .sc, .sc__obj, .tab { transition: none; }
    .detail__item.is-in { animation: none; }
  }

  /* ---------- tablet */
  @media (max-width: 1023px) {
    .detail__item {
      grid-template-columns: 56px 1fr;
      row-gap: var(--s-3);
    }
    .detail__line, .detail__cta { grid-column: 1 / -1; }
  }

  /* ---------- phone */
  @media (max-width: 639px) {
    .panel { --pad: var(--s-4); padding: var(--s-4) var(--pad); border-radius: var(--r-card); }
    .stage {
      --sc-w: 210px;
      --sc-h: 240px;
      --sc-rest: 0.8;
      --sc-gap: -24px;
      padding-top: 44px;
    }
    .sc__field { padding: 20px 18px 18px; border-radius: var(--r-card); }
    .sc[aria-checked='true'] .sc__field { padding-top: 44px; }
    .sc__name { font-size: 1.625rem; }
    .sc[data-lockup='display'] .sc__name { font-size: 2rem; }
    .sc__obj { top: -36px; height: 108px; }
    .sc:has(.sc__obj)[aria-checked='true'] .sc__name { margin-top: 76px; }
    .detail__cta :global(.btn) { width: 100%; }
  }
</style>
