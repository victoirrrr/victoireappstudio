---
// Split hero: the words on the left, the two live apps' App Store screenshots on the right with
// their icons beside them. Everything springs in once on load.
import { Picture } from 'astro:assets';
import { getApps } from '../lib/apps';
import Sparkle from './Sparkle.astro';

const apps = await getApps();
const live = apps.filter((a) => a.isLive && a.promoImages);
const [front, back] = live; // Kwesti in front, Morb behind
---

<section class="hero" aria-labelledby="hero-h">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="eyebrow" data-pop style="--d:0">Indie iOS studio · Since 2025</p>
      <h1 id="hero-h" data-pop style="--d:1">Apps built with <span class="accent">real purpose.</span></h1>
      <p class="lead" data-pop style="--d:2">
        I'm Vijay, and Victoir is my one-person studio. Every app starts with a real need in my own
        week: getting out into the world more, and making a phone recording sound right.
      </p>
      <div class="hero__actions" data-pop style="--d:3">
        <a class="btn btn--dark" href="#apps">
          See the apps
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="btn btn--ghost" href="#studio">Meet the studio</a>
      </div>
      <ul class="hero__facts" data-pop style="--d:4">
        <li><strong>500+</strong> downloads</li>
        <li><strong>4.8</strong> average rating</li>
        <li><strong>1</strong> person</li>
      </ul>
    </div>

    <div class="hero__art" aria-hidden="true">
      {back && (
        <div class="shot shot--back" data-pop style="--d:2">
          <Picture src={back.promoImages!.hero} formats={['avif']} fallbackFormat="webp" widths={[300, 600]} sizes="(max-width: 767px) 46vw, 300px" alt="" loading="eager" />
        </div>
      )}
      {front && (
        <div class="shot shot--front" data-pop style="--d:3">
          <Picture src={front.promoImages!.hero} formats={['avif']} fallbackFormat="webp" widths={[340, 680]} sizes="(max-width: 767px) 52vw, 340px" alt="" loading="eager" fetchpriority="high" />
        </div>
      )}
      {live.map((a, i) => (
        <div class={`float float--${i}`} data-pop style={`--d:${5 + i}`}>
          <div class="bob">
            {a.iconImage && <Picture src={a.iconImage} formats={['avif']} fallbackFormat="webp" width={88} height={88} densities={[1, 2]} alt="" class="app-icon" />}
          </div>
        </div>
      ))}
      <div class="float float--soon" data-pop style="--d:7">
        <div class="bob"><span class="app-icon app-icon--blank"><Sparkle /></span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + var(--s-8));
    padding-bottom: var(--s-8);
    min-height: min(100svh, 980px);
    display: flex;
    align-items: center;
    overflow: clip;
  }
  /* a soft crimson glow behind the screenshots, from the logo's ribbon */
  .hero::before {
    content: '';
    position: absolute;
    right: -10%;
    top: 6%;
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(226 69 63 / 0.16), transparent);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--s-7);
    align-items: center;
  }
  .hero__text { display: grid; gap: var(--s-5); justify-items: start; }
  .hero__text h1 { max-width: 11ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
  .hero__facts {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .hero__facts li { display: inline-flex; align-items: baseline; gap: 6px; }
  .hero__facts li + li::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--line-strong);
    align-self: center;
    margin-right: var(--s-3);
    margin-left: calc(-1 * var(--s-2));
  }
  .hero__facts strong { color: var(--ink); font-size: 1rem; }

  /* ---------- the art */
  .hero__art {
    position: relative;
    aspect-ratio: 1 / 1.02;
    width: 100%;
    max-width: 560px;
    justify-self: end;
  }
  .shot {
    position: absolute;
    border-radius: var(--r-card);
    overflow: clip;
    box-shadow: var(--shadow-phone);
    background: #fff;
  }
  .shot :global(img) { width: 100%; height: auto; }
  .shot--back { width: 50%; left: 6%; top: 8%; rotate: -7deg; }
  .shot--front { width: 56%; right: 4%; top: 2%; rotate: 5deg; }
  .shot {
    transition: opacity 400ms var(--ease), transform var(--t-slow) var(--spring), rotate var(--t-spring) var(--spring);
    transition-delay: calc(var(--d, 0) * 70ms), calc(var(--d, 0) * 70ms), 0s;
  }
  .shot--back:hover { rotate: -10deg; }
  .shot--front:hover { rotate: 2deg; }

  .float { position: absolute; z-index: 2; }
  .float :global(.app-icon) { width: 88px; height: 88px; }
  .float--0 { right: -2%; top: -4%; }
  .float--1 { left: -2%; top: 52%; }
  .float--soon { right: 10%; bottom: 0; }
  .float--soon .app-icon { width: 64px; height: 64px; }
  .bob { rotate: -4deg; transition: rotate var(--t-spring) var(--spring), scale var(--t-spring) var(--spring); }
  .float--1 .bob { rotate: 5deg; }
  .float:hover .bob { rotate: 0deg; scale: 1.08; }

  /* ---------- tablet and phone */
  @media (max-width: 1023px) {
    .hero__grid { grid-template-columns: 1fr; gap: var(--s-8); }
    .hero__art { justify-self: center; max-width: 520px; }
  }
  @media (max-width: 767px) {
    .hero { padding-top: calc(var(--nav-h) + var(--s-6)); }
    .hero__actions { width: 100%; }
    .hero__actions .btn { flex: 1 1 100%; }
    .hero__facts li + li::before { display: none; }
    .float :global(.app-icon) { width: 64px; height: 64px; }
    .float--soon .app-icon { width: 48px; height: 48px; }
  }
</style>
