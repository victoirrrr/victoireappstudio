---
// Logo left, three links right. Transparent at the top; frosted canvas and a 1px line after 40px.
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';

const links = [
  { href: '/#apps', label: 'Apps' },
  { href: '/#studio', label: 'Studio' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="nav" data-nav>
  <div class="wrap nav__row">
    <a class="skip-link" href="#main">Skip to content</a>
    <a class="nav__logo" href="/" aria-label="Victoir App Studio, home">
      <Image src={logo} alt="" width={132} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>
    <nav aria-label="Main">
      <ul class="nav__links">
        {links.map((l) => (
          <li><a class="nav__link" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const set = () => nav.classList.toggle('is-scrolled', window.scrollY > 40);
    set();
    window.addEventListener('scroll', set, { passive: true });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition: background-color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .nav.is-scrolled {
    background: rgb(246 245 246 / 0.86);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom-color: var(--line);
  }
  .nav__row {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: transform var(--t-spring) var(--spring);
  }
  .nav__logo:hover { transform: rotate(-3deg) scale(1.05); }
  .nav__logo img { width: 132px; height: auto; }
  .nav__links {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--s-2);
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-3);
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease),
      transform var(--t-spring) var(--spring);
  }
  .nav__link:hover {
    color: var(--ink);
    background: rgb(29 21 25 / 0.06);
    transform: translateY(-2px);
  }
  @media (max-width: 479px) {
    .nav__links { gap: 0; }
    .nav__link { font-size: 0.875rem; padding-inline: 10px; }
    .nav__logo img { width: 108px; }
  }
</style>
