---
// Slim dark footer: the logo and a line, one row of links (each live app's page, the studio, the
// email), then © and the Apple line. Each app's privacy, terms and support live on its own page.
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/logo-light.png';
import { getApps } from '../lib/apps';

const apps = (await getApps()).filter((a) => a.isLive);
const EMAIL = 'hello@victoirappstudio.com';
const links = [
  ...apps.map((a) => ({ label: a.name, href: `/${a.slug}` })),
  { label: 'Studio', href: '/#studio' },
  { label: EMAIL, href: `mailto:${EMAIL}` },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" aria-label="Victoir App Studio, home" class="footer__logo">
          <Image src={logoLight} alt="" width={140} densities={[1, 2]} />
        </a>
        <p>iPhone apps made by one person, since 2025.</p>
      </div>
      <nav aria-label="Footer">
        <ul class="footer__links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="footer__legal">
      <p>© {year} Victoir App Studio</p>
      <p>App Store is a service mark of Apple Inc.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--night);
    color: var(--night-ink-2);
    padding-block: var(--s-7) var(--s-5);
    font-size: var(--fs-small);
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5) var(--s-7);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--night-line);
  }
  .footer__brand { display: grid; gap: var(--s-3); }
  .footer__logo { display: inline-block; width: max-content; transition: transform var(--t-spring) var(--spring); }
  .footer__logo:hover { transform: rotate(-3deg) scale(1.04); }
  .footer__logo img { width: 140px; height: auto; }
  .footer__links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--s-5); }
  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--night-ink);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease), transform var(--t-spring) var(--spring);
  }
  .footer__links a:hover { color: var(--crimson-night); transform: translateY(-2px); }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    padding-top: var(--s-5);
  }
</style>
