---
// DESIGN.md "App card (ref 1)": a tall rounded card, picture on top fading into a tint sampled
// from it, title + status pill, a short body, up to two chips, a full-width white pill.
// Used by the spotlights and (next phase) the Kit family row.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  pill: string;
  body: string;
  chips?: string[];
  image?: ImageMetadata | null;
  imagePosition?: string;
  /** Tint the picture fades into; the text sits on it, so it must hold white at 4.5:1. */
  tint: string;
  action: { label: string; href?: string | null };
  headingLevel?: 'h3' | 'h4';
}

const { name, pill, body, chips = [], image, imagePosition = '50% 50%', tint, action, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article class:list={['card app-card', { 'm-nolift': !action.href }]} style={`--tint:${tint};--pos:${imagePosition}`}>
  <div class="app-card__media">
    {image ? (
      <Picture class="frame__img" src={image} formats={['avif']} fallbackFormat="webp" widths={[400, 800]} sizes="(max-width: 1279px) 320px, 400px" alt="" />
    ) : (
      <slot name="media" />
    )}
  </div>
  <div class="app-card__body">
    <div class="app-card__title">
      <H>{name}</H>
      <span class="app-card__pill">{pill}</span>
    </div>
    <p class="app-card__text">{body}</p>
    {chips.length > 0 && (
      <ul class="app-card__chips" aria-label={`${name} features`}>
        {chips.slice(0, 2).map((c) => <li>{c}</li>)}
      </ul>
    )}
    {action.href ? (
      <a class="btn btn--white app-card__btn" href={action.href} rel="noopener">{action.label}</a>
    ) : (
      <p class="app-card__btn app-card__soon">{action.label}</p>
    )}
  </div>
</article>

<style>
  .app-card {
    --card-w: 300px;
    --card-h: 470px;
    position: relative;
    display: flex;
    flex-direction: column;
    width: var(--card-w);
    height: var(--card-h);
    border-radius: var(--r-card);
    overflow: clip;
    background: var(--tint);
    color: #fff;
    box-shadow: var(--shadow-card);
  }
  /* top 55%: the picture, fading into the tint over its lower part */
  .app-card__media {
    position: relative;
    height: 55%;
    flex: none;
    overflow: clip;
  }
  .app-card__media :global(picture),
  .app-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .app-card__media :global(img) {
    object-fit: cover;
    object-position: var(--pos);
  }
  .app-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, var(--tint) 100%);
    pointer-events: none;
  }
  .app-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-4) var(--s-4);
  }
  .app-card__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .app-card__title :is(h3, h4) {
    font-family: var(--font-sans);
    font-size: var(--fs-card-title);
    line-height: var(--lh-h3);
    font-weight: 600;
    letter-spacing: 0;
  }
  .app-card__pill {
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: rgb(0 0 0 / 0.4);
    font-size: var(--fs-small);
    font-weight: 600;
    white-space: nowrap;
  }
  .app-card__text {
    font-size: var(--fs-card-body);
    line-height: var(--lh-card-body);
    color: rgb(255 255 255 / 0.78);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .app-card__chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .app-card__chips li {
    padding: 8px 12px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.14);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1;
  }
  .app-card__btn {
    margin-top: auto;
    width: 100%;
  }
  /* not a button: an app that is not out yet says so in the button's place, without a hover */
  .app-card__soon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--btn-h);
    border-radius: var(--r-pill);
    border: 1px solid rgb(255 255 255 / 0.28);
    color: rgb(255 255 255 / 0.86);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  @media (max-width: 1279px) {
    .app-card { --card-w: 280px; --card-h: 440px; }
  }
</style>
