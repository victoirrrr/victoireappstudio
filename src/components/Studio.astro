---
// The studio and the one way to reach it: the light logo on a dark tile, a short first-person note,
// three facts, the email, and a quiet line that more apps are on the way (no names).
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/logo-light.png';
import { getApps } from '../lib/apps';

const EMAIL = 'hello@victoirappstudio.com';
const soon = (await getApps()).filter((a) => !a.isLive).length;
const facts = [
  { value: '2025', label: 'Building iOS apps since' },
  { value: '500+', label: 'Downloads so far' },
  { value: '4.8', label: 'Average App Store rating' },
];
---

<section class="section studio" id="studio" aria-labelledby="studio-h">
  <div class="wrap studio__grid">
    <div class="studio__tile" data-pop>
      <Image src={logoLight} alt="Victoir App Studio logo" width={300} densities={[1, 2]} class="studio__logo" />
    </div>

    <div class="studio__text">
      <p class="eyebrow" data-pop>The studio</p>
      <h2 id="studio-h" data-pop style="--d:1">One person. Every app, start to finish.</h2>
      <p class="lead" data-pop style="--d:2">
        Victoir App Studio is me, Vijay Kumar. I design each app, build it, ship it and answer every
        email myself. Each one starts with something I wanted fixed in my own week.
        {soon > 0 && <> {soon === 1 ? 'One more is' : `${soon} more are`} on the way.</>}
      </p>
      <dl class="studio__facts" data-pop style="--d:3">
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <div class="studio__contact" id="contact" data-pop style="--d:4">
        <p>Support, feedback or press, write to me directly.</p>
        <a class="btn btn--dark" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .studio { background: var(--canvas-2); }
  .studio__grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: var(--s-8);
    align-items: center;
  }
  .studio__tile {
    aspect-ratio: 1;
    border-radius: var(--r-panel);
    background: var(--night);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-soft);
  }
  .studio__tile :global(.studio__logo) {
    width: 66%;
    height: auto;
    transition: transform var(--t-spring) var(--spring);
  }
  .studio__tile:hover :global(.studio__logo) { transform: scale(1.05) rotate(-2deg); }

  .studio__text { display: grid; gap: var(--s-5); justify-items: start; }
  .studio__text h2 { max-width: 13ch; }
  .studio__facts {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-strong);
    margin-top: var(--s-2);
  }
  .studio__facts > div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-4) 0;
  }
  .studio__facts > div:first-child { padding-left: 0; }
  .studio__facts > div + div { border-left: 1px solid var(--line-strong); }
  .studio__facts dd { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; color: var(--crimson-text); }
  .studio__facts dt { font-size: var(--fs-small); color: var(--ink-2); }
  .studio__contact {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-strong);
    scroll-margin-top: calc(var(--nav-h) + var(--s-6));
  }
  .studio__contact p { color: var(--ink-2); }

  @media (max-width: 1023px) {
    .studio__grid { grid-template-columns: 1fr; gap: var(--s-7); }
    .studio__tile { max-width: 360px; width: 100%; }
  }
  @media (max-width: 479px) {
    .studio__facts > div { padding-inline: var(--s-3); }
    .studio__facts dd { font-size: 1.5rem; }
    .studio__contact .btn { width: 100%; white-space: normal; }
  }
</style>
