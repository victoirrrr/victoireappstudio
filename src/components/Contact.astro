---
// The closing ask: a crimson panel with the studio email.
const EMAIL = 'hello@victoirappstudio.com';
---

<section class="section contact" id="contact" aria-labelledby="contact-h">
  <div class="wrap">
    <div class="contact__panel" data-pop>
      <h2 id="contact-h">Got a question or an idea?</h2>
      <p>I read every email. For support, feedback or press, write to me directly.</p>
      <a class="btn btn--white contact__btn" href={`mailto:${EMAIL}`}>
        Email {EMAIL}
      </a>
    </div>
  </div>
</section>

<style>
  .contact__panel {
    position: relative;
    overflow: clip;
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    padding: var(--s-9) var(--s-6);
    border-radius: var(--r-panel);
    text-align: center;
    color: #fff;
    background: linear-gradient(135deg, var(--crimson) 0%, var(--crimson-deep) 100%);
    box-shadow: 0 40px 80px -40px rgb(166 30 46 / 0.7);
  }
  /* the logo's star, big and faint, in the corner */
  .contact__panel::after {
    content: '';
    position: absolute;
    right: -60px;
    top: -60px;
    width: 280px;
    height: 280px;
    background: rgb(255 255 255 / 0.1);
    clip-path: path('M140 0c8 72 59 127 140 140-81 13-132 68-140 140-8-72-59-127-140-140 81-13 132-68 140-140Z');
    animation: twinkle 8s ease-in-out infinite;
  }
  @keyframes twinkle {
    50% { transform: rotate(20deg) scale(0.9); }
  }
  .contact__panel h2 { max-width: 14ch; }
  .contact__panel p { font-size: var(--fs-lead); max-width: 40ch; opacity: 0.92; }
  .contact__btn { color: var(--crimson-deep); }
  @media (max-width: 767px) {
    .contact__panel { padding: var(--s-8) var(--s-5); }
    .contact__btn { white-space: normal; height: auto; min-height: var(--btn-h); padding-block: var(--s-2); }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact__panel::after { animation: none; }
  }
</style>
