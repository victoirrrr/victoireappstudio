---
// App pages on this site (PRD 6): one per app whose siteUrl is "/<slug>" (Kit, Kit Pouch; GLP-1
// when it gets one). Hero with the real screens (or the icon on its field), then the rest of the
// app's family, then the shared closing footer. Kwesti and Morb keep their own sites.
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AppCard from '../../components/AppCard.astro';
import { getApps, storeLink, type App } from '../../lib/apps';
import { legalPaths } from '../../lib/legal';
import { appJsonLd, graph } from '../../lib/jsonld';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export const getStaticPaths = (async () => {
  const apps = await getApps();
  return apps.filter((a) => a.siteUrl === `/${a.slug}`).map((app) => ({ params: { app: app.slug }, props: { slug: app.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.props as { slug: string };
const apps = await getApps();
const app = apps.find((a) => a.slug === slug)!;
const family = app.family ? apps.filter((a) => a.family === app.family && a.slug !== app.slug) : [];
const legal = await legalPaths();
const supportHref = legal.has(`/${app.slug}/support`) ? `/${app.slug}/support` : null;
const store = storeLink(app, `app-page-${app.slug}`);
const kind = app.kind ?? 'an iOS app';
const shots = app.screenImages.slice(0, 3);
const label = (file: string) => file.replace(/\.[a-z]+$/i, '').replace(/^\d+[-_]/, '').replace(/[-_]/g, ' ');
const familyName = app.family ? `${app.family[0].toUpperCase()}${app.family.slice(1)}` : '';
const og = existsSync(join(process.cwd(), 'public', 'og', `${app.slug}.png`)) ? `/og/${app.slug}.png` : '/og/home.png';
const jsonLd = graph([appJsonLd(app, Astro.site!)]);
const actionFor = (a: App) =>
  a.siteUrl === `/${a.slug}`
    ? { label: `See ${a.name}`, href: a.siteUrl }
    : { label: a.status === 'planned' ? `Coming ${a.statusLabel}` : 'Coming soon', href: null };
---

<Base
  title={`${app.name}, ${kind}: victoir app studio`}
  description={app.oneLiner}
  appStoreId={app.isLive ? app.appStoreId : null}
  ogImage={og}
  jsonLd={jsonLd}
>
  <Nav />
  <main id="main">
    <section class="hero app-hero" data-enter aria-labelledby="app-h" style={`--tint:${app.palette.tint};--field:${app.palette.bg};--ac:${app.palette.accent}`}>
      <div class="wrap">
        <div class="hero-text app-hero__grid">
          <div class="app-hero__text">
            <div class="app-hero__id">
              {app.iconImage && (
                <Picture src={app.iconImage} formats={['avif']} fallbackFormat="webp" width={64} height={64} densities={[1, 2]} alt="" class="app-hero__icon" />
              )}
              <span class="app-hero__status">{app.isLive ? app.facts : app.statusLabel}</span>
            </div>
            <h1 id="app-h">{app.name}, {kind}</h1>
            <p class="hero__lead">{app.oneLiner}</p>
            <div class="app-hero__actions">
              {store ? (
                <a class="btn btn--primary" href={store} rel="noopener">Download on the App Store</a>
              ) : (
                <p class="app-hero__soon">{app.status === 'planned' ? `Coming ${app.statusLabel}` : 'Coming soon to the App Store'}</p>
              )}
              {supportHref && <a class="link app-hero__link" href={supportHref}>Get help with {app.name}</a>}
            </div>
            {app.chips.length > 0 && (
              <ul class="app-hero__chips" aria-label={`${app.name} features`}>
                {app.chips.map((c) => <li>{c}</li>)}
              </ul>
            )}
          </div>

          {shots.length > 0 ? (
            <div class="frame app-hero__art" data-enter-media>
              {shots.map((s, i) => (
                <div class="app-hero__shot" data-i={i}>
                  <Picture src={s} formats={['avif']} fallbackFormat="webp" widths={[240, 480]} sizes="(max-width: 639px) 110px, 240px"
                    alt={`${app.name} screen: ${label(app.screens[i])}`} loading="eager" />
                </div>
              ))}
            </div>
          ) : (
            <div class="frame app-hero__art app-hero__field" data-enter-media>
              {app.iconImage && (
                <Picture src={app.iconImage} formats={['avif']} fallbackFormat="webp" width={200} height={200} densities={[1, 2]}
                  alt={`${app.name} app icon`} class="app-hero__big-icon" loading="eager" />
              )}
            </div>
          )}
        </div>
      </div>
    </section>

    {family.length > 0 && (
      <section class="section fam" id="family" aria-labelledby="fam-h" style={`--h: 1; --span: ${Math.max(3, Math.floor(12 / family.length))}`}>
        <div class="wrap fam__grid">
          <div class="fam__head">
            <h2 id="fam-h">Also in the {familyName} family</h2>
            <p>The {familyName} apps work on their own and know about each other.</p>
          </div>
          {family.map((f) => (
            <AppCard name={f.name} pill={f.statusLabel} body={f.oneLiner} chips={f.chips} image={f.screenImages[0] ?? null}
              imagePosition="50% 30%" tint={f.palette.tint} action={actionFor(f)}>
              <div slot="media" class="frame fam__field" style={`--fc:${f.palette.bg};--ac:${f.palette.accent}`}>
                {f.iconImage ? (
                  <Picture src={f.iconImage} formats={['avif']} fallbackFormat="webp" width={112} height={112} densities={[1, 2]} alt={`${f.name} app icon`} class="fam__icon" />
                ) : (
                  <span class="fam__capsule" role="img" aria-label={`${f.name}, planned`}></span>
                )}
              </div>
            </AppCard>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  /* ---------- hero: text on the left, the app's screens (or its icon) on the right */
  .app-hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    padding-top: calc(var(--nav-h) + 48px);
    padding-bottom: 64px;
  }
  .app-hero > .wrap { position: relative; z-index: 1; height: 100%; }
  .app-hero__grid {
    height: 100%;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--grid-gap);
    align-items: start;
  }
  .app-hero__text { grid-column: 1 / span 5; display: grid; gap: var(--s-5); justify-items: start; }
  .app-hero__id { display: flex; align-items: center; gap: var(--s-4); }
  .app-hero__id :global(.app-hero__icon) { width: 64px; height: 64px; border-radius: 15px; box-shadow: var(--shadow-tile); }
  .app-hero__status {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .app-hero h1 { font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.5rem); max-width: 15ch; }
  .app-hero .hero__lead { max-width: 40ch; color: var(--ink); }
  .app-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); }
  .app-hero__soon { font-weight: 600; padding: 12px 20px; border-radius: var(--r-pill); border: 1px solid var(--line-strong); }
  .app-hero__link { font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .app-hero__chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .app-hero__chips li {
    padding: 8px 12px;
    border-radius: var(--r-pill);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .app-hero__art {
    grid-column: 7 / -1;
    align-self: stretch;
    display: flex;
    gap: var(--s-5);
    justify-content: space-between;
    align-items: flex-start;
    max-height: calc(100svh - var(--nav-h) - 112px);
  }
  .app-hero__shot {
    /* sized by the column's width: three phones share it, each at the screenshot's own ratio */
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 1320 / 2868;
    border-radius: var(--r-tile);
    overflow: clip;
    box-shadow: var(--shadow-tile);
    background: var(--field);
  }
  .app-hero__shot :global(picture), .app-hero__shot :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .app-hero__field {
    border-radius: var(--r-card);
    display: flex;
    justify-content: center;
    align-items: center;
    height: min(560px, 100%);
    background: radial-gradient(70% 70% at 50% 45%, color-mix(in oklab, var(--ac) 34%, var(--field)), var(--field) 75%);
    box-shadow: var(--shadow-card);
  }
  .app-hero__field :global(picture) { width: auto; height: auto; }
  .app-hero__field :global(.app-hero__big-icon) { width: 200px; height: 200px; border-radius: 44px; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6); }

  /* ---------- family */
  .fam__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--grid-gap);
    row-gap: var(--s-7);
    align-items: start;
  }
  .fam__head { grid-column: 1 / -1; display: grid; gap: var(--s-4); }
  .fam__grid :global(.app-card) { grid-column: span var(--span); --card-w: 100%; --card-h: 520px; }
  .fam__field {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: radial-gradient(70% 70% at 50% 45%, color-mix(in oklab, var(--ac) 34%, var(--fc)), var(--fc) 75%);
  }
  :global(.app-card__media) .fam__field :global(picture) { width: auto; height: auto; }
  .fam__field :global(.fam__icon) { width: 112px; height: 112px; border-radius: 25px; }
  .fam__capsule {
    width: 132px;
    height: 52px;
    border-radius: var(--r-pill); /* unslop-ignore: a drawn GLP-1 pill */
    background: linear-gradient(90deg, var(--ac) 50%, color-mix(in oklab, var(--ac) 30%, #fff) 50%);
    rotate: -18deg;
  }

  @media (max-width: 1279px) {
    .fam__grid :global(.app-card) { --card-h: 460px; }
  }
  @media (max-width: 1023px) {
    .app-hero { height: auto; min-height: 100svh; }
    .app-hero__text { grid-column: 1 / -1; }
    /* stacked: the art gets a fixed height and the screens size by it, so the hero stays one screen */
    .app-hero__art { grid-column: 1 / -1; margin-top: var(--s-7); height: 360px; max-height: none; justify-content: center; }
    .app-hero__shot { flex: none; height: 100%; width: auto; }
    .app-hero__field { height: 300px; }
    .fam__grid :global(.app-card) { grid-column: span 6; }
  }
  @media (max-width: 639px) {
    .app-hero { padding-top: calc(var(--nav-h) + 24px); }
    .app-hero__art { gap: var(--s-3); margin-top: var(--s-6); height: 200px; }
    .app-hero__field { height: 150px; }
    .app-hero__field :global(.app-hero__big-icon) { width: 112px; height: 112px; border-radius: 25px; }
    .app-hero__shot { border-radius: 16px; }
    .fam__grid { display: grid; grid-template-columns: 1fr; row-gap: var(--s-4); }
    .fam__head { margin-bottom: var(--s-4); }
    .fam__grid :global(.app-card) { grid-column: 1; --card-h: 340px; }
    .fam__grid :global(.app-card__chips) { display: none; }
  }
</style>
