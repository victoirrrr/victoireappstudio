---
// Home (DESIGN.md v3): nav, split hero, one photo showcase per live app (each linking to its own
// page), the studio with the email, the slim footer. Unlaunched apps show only as a blank
// "Coming soon" tile in the hero and a count in the studio note.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import Studio from '../components/Studio.astro';
import Footer from '../components/Footer.astro';
import { getApps } from '../lib/apps';
import { appJsonLd, graph } from '../lib/jsonld';

const apps = await getApps();
const shown = apps.filter((a) => a.isLive && a.feature && a.sceneImage);
const jsonLd = graph([
  { '@type': 'Organization', name: 'Victoir App Studio', url: Astro.site!.toString(), logo: new URL('/icon-512.png', Astro.site).toString(), founder: { '@type': 'Person', name: 'Vijay Kumar' } },
  ...apps.filter((a) => a.isLive).map((a) => appJsonLd(a, Astro.site!)),
]);
---

<Base
  title="Victoir App Studio: iPhone apps built with real purpose"
  description="Kwesti and Morb: iPhone apps for weekly side quests and for phone recordings that sound studio-made, made by one person."
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <Nav />
  <main id="main">
    <Hero />
    <section class="section apps" id="apps" aria-labelledby="apps-h">
      <div class="wrap">
        <div class="apps__head" data-pop>
          <p class="eyebrow">The apps</p>
          <h2 id="apps-h">Each one fixes <span class="accent">something real.</span></h2>
        </div>
        {shown.map((app, i) => <Showcase app={app} index={i} />)}
      </div>
    </section>
    <Studio />
  </main>
  <Footer />
</Base>

<style>
  .apps__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-7); }
  .apps__head h2 { max-width: 16ch; }
</style>
